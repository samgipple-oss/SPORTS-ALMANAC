
name: Update Sports Almanac fixtures

on:
  workflow_dispatch:
  schedule:
    - cron: "17 */3 * * *"

permissions:
  contents: write

jobs:
  update-fixtures:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests

      - name: Update sports fixtures
        run: |
          python scripts/update_fixtures.py

      - name: Commit updated fixture data
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add sports-fixtures.json

          if ! git diff --cached --quiet; then
            git commit -m "Automatically update sports fixtures"
            git push
          else
            echo "No fixture changes to commit"
          fi
